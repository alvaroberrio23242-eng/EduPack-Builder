# Variables de entorno de EduPack Builder.
# Copia este archivo como .env (que está en .gitignore) y rellena los valores.
# Nunca subas un .env real al repositorio.

# Obligatoria en producción: si falta, la app NO arranca (falla al inicio).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<genera-una-clave-aleatoria-y-no-la-coples-aqui>

# Modo desarrollo local (opt-in explícito): con "1", la app genera una clave
# efímera al arrancar si no hay SECRET_KEY. Déjalo en 0 (o borra la línea) en
# producción. Nunca la actives en un servidor publicado.
EDUPACK_DEV=0

# "1" activa el modo debug de Flask al correr `python app.py` (0 por defecto).
# Nunca lo actives en producción.
FLASK_DEBUG=0

# Puerto HTTP para el servidor local (por defecto 5000).
PORT=5000
